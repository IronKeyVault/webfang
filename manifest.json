{
  "manifest_version": 3,
  "name": "Webfang",
  "version": "1.8.4",
  "description": "Optag en artikel fra en webside inkl. billeder og kopiér til udklipsholder som rich HTML – eller hent sidens video ned som fil.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "downloads",
    "webRequest",
    "storage",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webfang"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-pick": {
      "suggested_key": { "default": "Ctrl+Shift+Z" },
      "description": "Optag artikel med Webfang"
    },
    "start-pick-video": {
      "suggested_key": { "default": "Alt+X" },
      "description": "Optag video med Webfang"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/00-core.js",
        "src/05-state.js",
        "src/10-text.js",
        "src/20-ui.js",
        "src/30-page.js",
        "src/40-media.js",
        "src/45-tables.js",
        "src/50-quiz.js",
        "src/55-clean.js",
        "src/60-images.js",
        "src/70-capture.js",
        "src/75-iframes.js",
        "src/80-region.js",
        "src/85-video.js",
        "src/90-app.js",
        "src/95-diagnose.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
