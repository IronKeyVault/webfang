{
  "manifest_version": 3,
  "name": "Webfang",
  "version": "1.0.0",
  "description": "Optag en artikel fra en webside inkl. billeder og kopiér til udklipsholder som rich HTML.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webfang"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
