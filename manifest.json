{
  "manifest_version": 3,
  "name": "Webfang",
  "version": "1.4.2",
  "description": "Optag en artikel fra en webside inkl. billeder og kopiér til udklipsholder som rich HTML – eller hent sidens video ned som fil.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "downloads",
    "webRequest",
    "storage",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webfang"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-pick": {
      "suggested_key": { "default": "Ctrl+Shift+Z" },
      "description": "Optag artikel med Webfang"
    },
    "start-pick-video": {
      "suggested_key": { "default": "Alt+X" },
      "description": "Optag video med Webfang"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
